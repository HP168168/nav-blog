---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "现代化导航与独立技术博客" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased selection:bg-emerald-500 selection:text-white">
    <!-- 背景光晕 -->
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -right-40 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/2 w-96 h-96 bg-violet-500/5 rounded-full blur-3xl"></div>
    </div>

    <!-- 顶栏导航 -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group flex-shrink-0">
          <span class="text-2xl">🧭</span>
          <span class="font-bold text-lg bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent group-hover:opacity-90 transition">
            NaviBlog
          </span>
        </a>

        <nav class="flex items-center gap-1 sm:gap-2 text-sm font-medium">
          <a
            href="/"
            class={`px-3 py-2 rounded-lg transition flex items-center gap-1.5 ${currentPath === '/' ? 'text-emerald-400 bg-emerald-500/10' : 'text-slate-300 hover:text-emerald-400 hover:bg-slate-800/60'}`}
          >
            <span>🌐</span> <span class="hidden sm:inline">网址导航</span>
          </a>
          <a
            href="/blog"
            class={`px-3 py-2 rounded-lg transition flex items-center gap-1.5 ${currentPath.startsWith('/blog') ? 'text-emerald-400 bg-emerald-500/10' : 'text-slate-300 hover:text-emerald-400 hover:bg-slate-800/60'}`}
          >
            <span>📝</span> <span class="hidden sm:inline">精选博客</span>
          </a>

          <!-- 营销工具箱 下拉菜单 -->
          <div class="relative group/tools">
            <button
              class={`px-3 py-2 rounded-lg transition flex items-center gap-1.5 cursor-pointer ${currentPath.startsWith('/tools') ? 'text-violet-400 bg-violet-500/10' : 'text-slate-300 hover:text-violet-400 hover:bg-slate-800/60'}`}
            >
              <span>🛠️</span>
              <span class="hidden sm:inline">营销工具</span>
              <svg class="w-3 h-3 opacity-60 transition-transform group-hover/tools:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <!-- 下拉面板 -->
            <div class="absolute right-0 top-full mt-2 w-52 rounded-xl bg-slate-900 border border-slate-700/80 shadow-2xl shadow-black/50 opacity-0 invisible group-hover/tools:opacity-100 group-hover/tools:visible transition-all duration-200 translate-y-1 group-hover/tools:translate-y-0">
              <div class="p-1.5">
                <a
                  href="/tools/title-generator"
                  class={`flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors ${currentPath === '/tools/title-generator' ? 'bg-violet-500/15 text-violet-300' : 'text-slate-300 hover:bg-slate-800 hover:text-violet-400'}`}
                >
                  <span class="text-lg flex-shrink-0">🏷️</span>
                  <div>
                    <div class="text-sm font-medium">标题生成器</div>
                    <div class="text-[11px] text-slate-500">批量 SEO 标题矩阵</div>
                  </div>
                </a>
                <a
                  href="/tools/ai-writer"
                  class={`flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors mt-0.5 ${currentPath === '/tools/ai-writer' ? 'bg-emerald-500/15 text-emerald-300' : 'text-slate-300 hover:bg-slate-800 hover:text-emerald-400'}`}
                >
                  <span class="text-lg flex-shrink-0">✍️</span>
                  <div>
                    <div class="text-sm font-medium">AI 文章创作</div>
                    <div class="text-[11px] text-slate-500">智能 B2B 软文生成</div>
                  </div>
                </a>
              </div>
            </div>
          </div>

          <a
            href="/cms/"
            class="px-3 py-1.5 rounded-lg bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 hover:bg-emerald-600 hover:text-white transition flex items-center gap-1 shadow-sm shadow-emerald-500/10 ml-1"
          >
            <span>⚙️</span> <span class="hidden sm:inline">后台管理</span>
          </a>
        </nav>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <footer class="mt-20 border-t border-slate-900 py-8 text-center text-xs text-slate-500">
      <p>© {new Date().getFullYear()} NaviBlog · Powered by Astro & Keystatic · 纯静态秒开</p>
    </footer>
  </body>
</html>
