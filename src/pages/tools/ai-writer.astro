---
import Layout from '../../layouts/Layout.astro';
import AiWriter from '../../components/tools/AiWriter';
---

<Layout
  title="黄页88风格 AI文章创作 · B2B企业软文与产品推广写作"
  description="面向B2B工业品与产品详情的AI智能软文创作工具，支持本地高质量模板秒生与大模型API接入，提供SEO质量看板与导出功能"
>
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium mb-3">
      <span>✍️</span> 黄页88 AI文章创作
    </div>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white">
          AI 企业软文与文章 <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">创作工作台</span>
        </h1>
        <p class="text-slate-400 text-xs sm:text-sm mt-1">
          为工业品与企业产品量身打造，支持规格参数表、FAQ采购问答、SEO密度检测与一键导出。
        </p>
      </div>
      <a
        href="/tools/title-generator"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-violet-500/10 border border-violet-500/20 text-violet-400 hover:bg-violet-500/20 text-xs font-medium transition self-start sm:self-auto"
      >
        <span>🏷️</span> 去生成标题矩阵 ↗
      </a>
    </div>
  </div>

  <AiWriter client:load />
</Layout>
