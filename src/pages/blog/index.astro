---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
posts.sort((a, b) => {
  const dateA = new Date(a.data.publishedDate || 0).getTime();
  const dateB = new Date(b.data.publishedDate || 0).getTime();
  return dateB - dateA;
});
---

<Layout title="精选博客 · 技术文章与动态">
  <div class="max-w-4xl mx-auto">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-extrabold text-white mb-3">
        精选 <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">技术博客</span>
      </h1>
      <p class="text-slate-400 text-sm">
        深度技术总结、开发随笔与行业洞察。支持在后台自由创作。
      </p>
    </div>

    {posts.length === 0 ? (
      <div class="text-center py-20 text-slate-500">
        <p class="text-4xl mb-3">✍️</p>
        <p>暂无文章，前往 <a href="/keystatic" class="text-emerald-400 underline">/keystatic 后台</a> 发布第一篇博客吧！</p>
      </div>
    ) : (
      <div class="space-y-6">
        {posts.map((post) => (
          <article class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800/80 hover:border-emerald-500/40 hover:bg-slate-900/90 transition-all duration-300 group">
            <a href={`/blog/${post.id}`} class="block">
              <div class="flex items-center gap-3 text-xs text-slate-500 mb-2">
                {post.data.category && (
                  <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-medium">
                    {post.data.category}
                  </span>
                )}
                {post.data.publishedDate && (
                  <time>{new Date(post.data.publishedDate).toLocaleDateString('zh-CN')}</time>
                )}
              </div>
              <h2 class="text-xl font-bold text-slate-100 group-hover:text-emerald-400 transition mb-2">
                {post.data.title}
              </h2>
              <p class="text-sm text-slate-400 line-clamp-2 leading-relaxed">
                {post.data.summary || '点击阅读全文...'}
              </p>
              <div class="mt-4 flex items-center text-xs font-medium text-emerald-400 gap-1 group-hover:translate-x-1 transition-transform">
                阅读全文 <span>→</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    )}
  </div>
</Layout>
