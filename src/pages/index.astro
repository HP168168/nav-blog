---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const rawCategories = await getCollection('navigation');
const categories = rawCategories
  .map(c => c.data)
  .sort((a, b) => a.order - b.order);

const totalSites = categories.reduce((sum, cat) => sum + (cat.links?.length || 0), 0);
---

<Layout title="网址导航 · 精选效率工具与资源">
  <!-- Hero 介绍区 -->
  <section class="text-center py-12 sm:py-16">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      已收录 {categories.length} 个分类 · 共 {totalSites} 个精选站点
    </div>
    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
      极客与开发者的 <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">数字导航站</span>
    </h1>
    <p class="max-w-2xl mx-auto text-slate-400 text-sm sm:text-base">
      精选 AI 工具、开发框架与高效神器。支持在 <a href="/keystatic" class="text-emerald-400 hover:underline">/keystatic 后台</a> 在线管理。
    </p>

    <!-- 实时搜索输入框 -->
    <div class="mt-8 max-w-xl mx-auto relative">
      <input
        type="text"
        id="siteSearch"
        placeholder="输入关键字搜索站点或简介 (快捷键 /)"
        class="w-full px-5 py-3.5 pl-12 rounded-xl bg-slate-900/90 border border-slate-800 text-slate-200 placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition shadow-lg"
      />
      <span class="absolute left-4 top-3.5 text-slate-500 text-lg">🔍</span>
    </div>

    <!-- 分类快速跳转胶囊 -->
    <div class="flex flex-wrap items-center justify-center gap-2 mt-6">
      {categories.map((cat) => (
        <a
          href={`#cat-${cat.name}`}
          class="px-3 py-1.5 rounded-lg bg-slate-900/60 border border-slate-800/80 text-xs text-slate-400 hover:text-emerald-400 hover:border-emerald-500/40 hover:bg-slate-800/80 transition"
        >
          {cat.icon} {cat.name}
        </a>
      ))}
    </div>
  </section>

  <!-- 分类列表与卡片网格 -->
  <div class="space-y-12">
    {categories.map((cat) => (
      <section id={`cat-${cat.name}`} class="category-block scroll-mt-24">
        <div class="flex items-center gap-3 mb-5 border-b border-slate-800/60 pb-3">
          <span class="text-2xl p-2 rounded-lg bg-slate-900 border border-slate-800 shadow-inner">
            {cat.icon}
          </span>
          <div>
            <h2 class="text-lg font-bold text-slate-100">{cat.name}</h2>
            <p class="text-xs text-slate-500">{cat.links.length} 个优质站点</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {cat.links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="site-card group p-4 rounded-xl bg-slate-900/50 border border-slate-800/80 hover:border-emerald-500/50 hover:bg-slate-900 hover:shadow-xl hover:shadow-emerald-500/5 transition-all duration-300 flex flex-col justify-between"
              data-title={link.title.toLowerCase()}
              data-desc={(link.description || '').toLowerCase()}
            >
              <div>
                <div class="flex items-start justify-between gap-2 mb-2">
                  <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-lg bg-slate-800/80 border border-slate-700/60 flex items-center justify-center text-base group-hover:scale-105 transition">
                      {link.icon || '🌐'}
                    </span>
                    <span class="font-semibold text-slate-200 text-sm group-hover:text-emerald-400 transition">
                      {link.title}
                    </span>
                  </div>
                  {link.tag && (
                    <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium whitespace-nowrap">
                      {link.tag}
                    </span>
                  )}
                </div>
                <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">
                  {link.description || '暂无详细描述'}
                </p>
              </div>
              <div class="mt-3 pt-2.5 border-t border-slate-800/40 flex items-center justify-between text-[11px] text-slate-500 group-hover:text-slate-400">
                <span class="truncate max-w-[180px]">{link.url.replace(/^https?:\/\//, '')}</span>
                <span class="text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity">↗</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <!-- 搜索无结果提示 -->
  <div id="noResults" class="hidden text-center py-16 text-slate-500">
    <p class="text-4xl mb-2">🔎</p>
    <p class="text-sm">没有找到匹配的站点，换个关键词试试？</p>
  </div>
</Layout>

<script>
  // 快速实时搜索交互
  const searchInput = document.getElementById('siteSearch') as HTMLInputElement;
  const cards = document.querySelectorAll<HTMLElement>('.site-card');
  const catBlocks = document.querySelectorAll<HTMLElement>('.category-block');
  const noResults = document.getElementById('noResults');

  searchInput?.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value.trim().toLowerCase();
    let totalVisible = 0;

    cards.forEach((card) => {
      const title = card.getAttribute('data-title') || '';
      const desc = card.getAttribute('data-desc') || '';
      const match = !val || title.includes(val) || desc.includes(val);
      card.style.display = match ? 'flex' : 'none';
      if (match) totalVisible++;
    });

    catBlocks.forEach((block) => {
      const visibleCards = block.querySelectorAll('.site-card:not([style*="display: none"])');
      block.style.display = visibleCards.length > 0 ? 'block' : 'none';
    });

    if (noResults) {
      noResults.style.display = totalVisible === 0 ? 'block' : 'none';
    }
  });

  // 按快捷键 / 聚焦到搜索框
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== searchInput) {
      e.preventDefault();
      searchInput?.focus();
    }
  });
</script>
